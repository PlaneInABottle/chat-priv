# Copy this file to .env.server.local and keep the copy out of git.
# Values in .env.server.local override .env and .env.local for PM2 roles.

RAILS_ENV=production
NODE_ENV=production
RAILS_SERVE_STATIC_FILES=true
RAILS_LOG_TO_STDOUT=true
INSTALLATION_ENV=linux_script
DISABLE_ENTERPRISE=true
ENABLE_ACCOUNT_SIGNUP=false
REQUIRE_EMAIL_CONFIRMATION=true
FORCE_SSL=true

FRONTEND_URL=https://app.kozmopath.com
SECRET_KEY_BASE=

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=
REDIS_URL=redis://127.0.0.1:6379

RAILS_MAX_THREADS=5
SIDEKIQ_CONCURRENCY=2
DISABLE_SIDEKIQ_ALIVE=true
SIDEKIQ_ALIVE_HOST=127.0.0.1

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
CHATWOOT_INTERNAL_API_URL=http://127.0.0.1:3000
VOICE_AGENT_INTERNAL_TOKEN=
VOICE_AGENT_NAME=kozmopath-voice-agent
VOICE_AGENT_MAX_CONCURRENT_JOBS=2
VOICE_AGENT_DRAIN_TIMEOUT_SECONDS=300
VOICE_AGENT_HEALTH_HOST=127.0.0.1
VOICE_AGENT_HEALTH_PORT=9090
VOICE_AGENT_PROMETHEUS_PORT=9091
GOOGLE_API_KEY=
OPENAI_API_KEY=

ACTIVE_STORAGE_SERVICE=s3_compatible
VIPS_BLOCK_UNTRUSTED=1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET_NAME=kozmopath-chat-attachments
STORAGE_REGION=auto
STORAGE_ENDPOINT=https://<cloudflare-account-id>.eu.r2.cloudflarestorage.com
STORAGE_FORCE_PATH_STYLE=true
AWS_REQUEST_CHECKSUM_CALCULATION=WHEN_REQUIRED
AWS_RESPONSE_CHECKSUM_VALIDATION=WHEN_REQUIRED

VOICE_RECORDING_STORAGE_PROVIDER=s3_compatible
VOICE_RECORDING_S3_ACCESS_KEY_ID=
VOICE_RECORDING_S3_SECRET_ACCESS_KEY=
VOICE_RECORDING_S3_BUCKET=kozmopath-chat-attachments
VOICE_RECORDING_S3_REGION=auto
VOICE_RECORDING_S3_ENDPOINT=https://<cloudflare-account-id>.eu.r2.cloudflarestorage.com
VOICE_RECORDING_S3_FORCE_PATH_STYLE=true
VOICE_RECORDING_S3_PREFIX=voice-recordings

MAILER_SENDER_EMAIL=Kozmopath <accounts@kozmopath.com>
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
