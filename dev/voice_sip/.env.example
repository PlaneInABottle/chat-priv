# Copy to dev/voice_sip/.env and adjust values before running docker compose.

# Chatwoot routing target. Find these from Rails console or Super Admin.
VOICE_SIP_ACCOUNT_ID=
VOICE_SIP_VOICE_INBOX_SETTING_ID=
VOICE_SIP_PROVIDER=test_sip
VOICE_SIP_CONNECTION_NAME="Local Asterisk"

# Softphone account registered against local Asterisk.
ASTERISK_SOFTPHONE_USER=1001
ASTERISK_SOFTPHONE_PASSWORD=change-me-softphone
ASTERISK_DIAL_EXTENSION=9000
ASTERISK_CALLER_ID=+905551112233

# Fake provider number. This must match the LiveKit inbound trunk number
# and the Chatwoot VoiceNumber.phone_number.
VOICE_SIP_PHONE_NUMBER=+908501112233

# LiveKit SIP endpoint from LiveKit Cloud Project settings, without "sip:".
# Example: abc123.sip.livekit.cloud
LIVEKIT_SIP_HOST=

# Must match the auth credentials configured on the LiveKit inbound trunk.
LIVEKIT_SIP_AUTH_USERNAME=chatwoot-local
LIVEKIT_SIP_AUTH_PASSWORD=change-me-livekit-sip
LIVEKIT_SIP_TRUNK_NAME=
LIVEKIT_SIP_DISPATCH_NAME=
LIVEKIT_SIP_ROOM_PREFIX=local-sip-

# Optional NAT hints.
#
# Local softphone calls use UDP 5060. In Docker on macOS, set the softphone
# addresses to your Mac's LAN IP if the phone is on the same Wi-Fi/LAN.
ASTERISK_SOFTPHONE_SIGNALING_ADDRESS=
ASTERISK_SOFTPHONE_MEDIA_ADDRESS=

# LiveKit Cloud SIP uses UDP 5061. If SIP connects but cloud audio fails,
# set these to your public IP and forward UDP 10000-10100 from your router
# to this machine.
ASTERISK_EXTERNAL_SIGNALING_ADDRESS=
ASTERISK_EXTERNAL_MEDIA_ADDRESS=
# Keep this narrow. Docker Desktop can make phone traffic appear from
# 192.168.65.1, and a broad 192.168.0.0/16 makes Asterisk advertise its
# container IP instead of ASTERISK_SOFTPHONE_MEDIA_ADDRESS.
ASTERISK_LOCAL_NET=127.0.0.0/8
ASTERISK_DOCKER_LOCAL_NET=172.24.0.0/16
