[global]
type=global
user_agent=Chatwoot Local Asterisk

[transport-softphone]
type=transport
protocol=udp
bind=0.0.0.0:5060
external_signaling_address=${ASTERISK_SOFTPHONE_SIGNALING_ADDRESS}
external_media_address=${ASTERISK_SOFTPHONE_MEDIA_ADDRESS}
local_net=${ASTERISK_LOCAL_NET}
local_net=${ASTERISK_DOCKER_LOCAL_NET}

[transport-livekit]
type=transport
protocol=udp
bind=0.0.0.0:5061
external_signaling_address=${ASTERISK_EXTERNAL_SIGNALING_ADDRESS}
external_media_address=${ASTERISK_EXTERNAL_MEDIA_ADDRESS}
local_net=${ASTERISK_LOCAL_NET}
local_net=${ASTERISK_DOCKER_LOCAL_NET}

[softphone-auth]
type=auth
auth_type=userpass
username=${ASTERISK_SOFTPHONE_USER}
password=${ASTERISK_SOFTPHONE_PASSWORD}

[${ASTERISK_SOFTPHONE_USER}]
type=aor
max_contacts=3
remove_existing=yes

[${ASTERISK_SOFTPHONE_USER}]
type=endpoint
context=from-softphone
transport=transport-softphone
callerid="Chatwoot Local" <${ASTERISK_CALLER_ID}>
disallow=all
allow=g722
allow=ulaw
allow=alaw
auth=softphone-auth
aors=${ASTERISK_SOFTPHONE_USER}
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes

[livekit-auth]
type=auth
auth_type=userpass
username=${LIVEKIT_SIP_AUTH_USERNAME}
password=${LIVEKIT_SIP_AUTH_PASSWORD}

[livekit-aor]
type=aor
contact=sip:${LIVEKIT_SIP_HOST}:5060

[livekit]
type=endpoint
context=from-livekit
transport=transport-livekit
disallow=all
allow=ulaw
allow=alaw
aors=livekit-aor
outbound_auth=livekit-auth
from_domain=${LIVEKIT_SIP_HOST}
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
send_rpid=yes
trust_id_outbound=yes
