<section class="main-content__body">
  <div class="sa-card">
    <h3 class="sa-section-title mb-2">Reset Frontend Cache</h3>
    <p class="text-sm text-slate-500 mb-3">Clear the IndexedDB cache keys from Redis. The next load will fetch data from the backend.</p>
    <%= form_for([:reset_cache, namespace, page.resource], method: :post, html: { class: "form" }) do |f| %>
      <div class="flex items-center gap-3">
        <%= f.submit 'Reset Frontend Cache' %>
      </div>
    <% end %>
  </div>
</section>
