<% if ENV.fetch('ENABLE_ACCOUNT_SEEDING', !Rails.env.production?)  %>
<section class="main-content__body">
  <div class="sa-card">
    <h3 class="sa-section-title mb-2">Seed Data</h3>
    <p class="text-sm text-slate-500 mb-3">Generate seed data into this account for demos.</p>
    <%= form_for([:seed, namespace, page.resource], method: :post, html: { class: "form" }) do |f| %>
      <div class="flex items-center gap-3">
        <%= f.submit 'Generate Seed Data' %>
        <p class="text-sm text-red-600 font-medium m-0">Warning: This will clear all existing data in this account.</p>
      </div>
    <% end %>
  </div>
</section>
<% end %>
