<li class="px-3 mb-0.5">
  <details class="group" <%= 'open' if open %>>
    <summary class="flex items-center px-3 py-1.5 cursor-pointer rounded-md list-none transition-colors <%= open ? 'text-woot-500 bg-woot-50/60 font-medium' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50' %>">
      <%= link_to super_admin_settings_url, class: 'flex items-center flex-1' do %>
        <svg width="16" height="16" class="flex-shrink-0"><use xlink:href="#icon-settings-2-line" /></svg>
        <span class="ml-2.5 text-sm">Settings</span>
      <% end %>
      <svg class="ml-auto w-3.5 h-3.5 transition-transform duration-200 group-open:rotate-180 text-slate-400" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
      </svg>
    </summary>
    <ul class="ml-4 mt-1">
      <% settings_pages.each do |_feature_key, attrs| %>
        <% url = super_admin_app_config_url(config: attrs['config_key']) %>
        <li class="px-3 mb-0.5">
          <% if current_page?(url) %>
            <%= link_to url, class: 'flex items-center px-3 py-1.5 text-woot-500 bg-woot-50/60 rounded-md font-medium transition-colors' do %>
              <span class="ml-2.5 text-sm"><%= attrs['name'] %></span>
            <% end %>
          <% else %>
            <%= link_to url, class: 'flex items-center px-3 py-1.5 text-slate-600 rounded-md hover:text-slate-900 hover:bg-slate-50 transition-colors' do %>
              <span class="ml-2.5 text-sm"><%= attrs['name'] %></span>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </details>
</li>
