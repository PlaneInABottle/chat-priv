<section class="main-content__body">
  <div class="flex flex-col gap-3 mb-6 md:flex-row md:items-start md:justify-between">
    <div>
      <h1 class="text-2xl font-medium text-n-slate-12">AI Prompt Preview</h1>
      <p class="text-sm text-n-slate-11 mb-0 mt-1">
        Read-only Super Admin view of the effective system prompt, enabled tool contracts, and integration gates.
      </p>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to 'AI Agent Tools', super_admin_ai_agent_tools_path, class: 'button' %>
      <%= link_to 'Execution logs', super_admin_ai_agent_tool_executions_path, class: 'button' %>
    </div>
  </div>

  <div class="outline outline-1 outline-n-container rounded-lg shadow-sm p-4 mb-6">
    <%= form_with url: super_admin_ai_agent_prompt_preview_path, method: :get, local: true, class: 'grid grid-cols-1 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto] gap-4 md:items-end' do %>
      <div>
        <label for="account_id" class="block text-sm font-medium text-n-slate-12 mb-1">Account</label>
        <%= select_tag :account_id,
                       options_for_select([['Select account', '']] + @account_options, @account&.id),
                       onchange: 'this.form.submit()',
                       class: 'w-full' %>
      </div>
      <div>
        <label for="ai_agent_id" class="block text-sm font-medium text-n-slate-12 mb-1">AI agent</label>
        <%= select_tag :ai_agent_id,
                       options_for_select([['Select AI agent', '']] + @ai_agent_options, @ai_agent&.id || params[:ai_agent_id]),
                       disabled: @account.blank? || @ai_agent_options.empty?,
                       class: 'w-full' %>
      </div>
      <%= submit_tag 'Preview', class: 'button h-10' %>
    <% end %>
  </div>

  <% if params[:account_id].present? && @account.blank? %>
    <div class="outline outline-1 outline-n-container rounded-lg p-4">
      <h2 class="text-base font-medium text-n-slate-12 mb-1">Account not found</h2>
      <p class="text-sm text-n-slate-11 mb-0">Select a valid account to inspect its AI agent prompt.</p>
    </div>
  <% elsif @account.blank? %>
    <div class="outline outline-1 outline-n-container rounded-lg p-4">
      <h2 class="text-base font-medium text-n-slate-12 mb-1">Select an account</h2>
      <p class="text-sm text-n-slate-11 mb-0">Choose an account to load its AI agents and preview prompt state.</p>
    </div>
  <% elsif @ai_agent_options.empty? %>
    <div class="outline outline-1 outline-n-container rounded-lg p-4">
      <h2 class="text-base font-medium text-n-slate-12 mb-1">No AI agents</h2>
      <p class="text-sm text-n-slate-11 mb-0"><%= @account.name %> does not have an AI agent to preview.</p>
    </div>
  <% elsif @preview.blank? %>
    <div class="outline outline-1 outline-n-container rounded-lg p-4">
      <h2 class="text-base font-medium text-n-slate-12 mb-1">Select an AI agent</h2>
      <p class="text-sm text-n-slate-11 mb-0">Choose one AI agent from <%= @account.name %> to inspect its effective prompt.</p>
    </div>
  <% else %>
    <% integration_gates_by_tool = @preview.integration_gates.index_by { |gate| gate[:tool_key] } %>
    <% enabled_class = @preview.ai_agent.enabled? ? 'bg-green-100 text-green-800' : 'bg-slate-100 text-slate-700' %>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-3 mb-6">
      <div class="outline outline-1 outline-n-container rounded-lg p-4">
        <p class="text-sm text-n-slate-11 mb-1">Account</p>
        <p class="text-base font-medium text-n-slate-12 mb-0"><%= @preview.account.name %> #<%= @preview.account.id %></p>
      </div>
      <div class="outline outline-1 outline-n-container rounded-lg p-4">
        <p class="text-sm text-n-slate-11 mb-1">AI agent</p>
        <p class="text-base font-medium text-n-slate-12 mb-0"><%= @preview.ai_agent.name %> #<%= @preview.ai_agent.id %></p>
      </div>
      <div class="outline outline-1 outline-n-container rounded-lg p-4">
        <p class="text-sm text-n-slate-11 mb-1">Runtime status</p>
        <span class="inline-flex rounded-full px-2 py-1 text-xs font-medium <%= enabled_class %>">
          <%= @preview.ai_agent.enabled? ? 'Enabled' : 'Disabled' %>
        </span>
      </div>
      <div class="outline outline-1 outline-n-container rounded-lg p-4">
        <p class="text-sm text-n-slate-11 mb-1">Model</p>
        <p class="text-base font-medium text-n-slate-12 mb-0"><%= @preview.model %></p>
      </div>
    </div>

    <div class="outline outline-1 outline-n-container rounded-lg p-4 mb-6">
      <div class="flex items-start justify-between gap-4 mb-3">
        <div>
          <h2 class="text-lg font-medium text-n-slate-12 mb-1">Enabled tools</h2>
          <p class="text-sm text-n-slate-11 mb-0">Only these tool schemas are available to the AI agent for this account.</p>
        </div>
      </div>
      <% if @preview.enabled_tool_definitions.empty? %>
        <p class="text-sm text-n-slate-11 mb-0">No tools are enabled.</p>
      <% else %>
        <div class="flex flex-col gap-3">
          <% @preview.enabled_tool_definitions.each do |tool| %>
            <% gate = integration_gates_by_tool[tool.key] %>
            <% gate_state = gate[:state] %>
            <% gate_class = gate_state.in?(%w[connected enabled not_required]) ? 'bg-green-100 text-green-800' : 'bg-amber-100 text-amber-800' %>
            <details class="outline outline-1 outline-n-container rounded-lg p-3">
              <summary class="cursor-pointer list-none">
                <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
                  <div>
                    <p class="font-medium text-n-slate-12 mb-0"><%= tool.key %></p>
                    <p class="text-sm text-n-slate-11 mb-0"><%= tool.description %></p>
                  </div>
                  <span class="inline-flex self-start rounded-full px-2 py-1 text-xs font-medium <%= gate_class %>">
                    <%= gate_state.to_s.humanize %>
                  </span>
                </div>
              </summary>
              <dl class="grid grid-cols-1 md:grid-cols-3 gap-3 mt-4">
                <div>
                  <dt class="text-sm font-medium text-n-slate-12">Integration</dt>
                  <dd class="text-sm text-n-slate-11"><%= gate[:app_id].presence || 'None' %></dd>
                </div>
                <div>
                  <dt class="text-sm font-medium text-n-slate-12">Store host</dt>
                  <dd class="text-sm text-n-slate-11"><%= gate[:store_host].presence || 'None' %></dd>
                </div>
                <div>
                  <dt class="text-sm font-medium text-n-slate-12">Error code</dt>
                  <dd class="text-sm text-n-slate-11"><%= gate[:error_code].presence || 'None' %></dd>
                </div>
              </dl>
              <h3 class="text-sm font-medium text-n-slate-12 mt-4 mb-2">Input schema</h3>
              <pre class="overflow-auto rounded bg-slate-100 p-4 text-xs"><code><%= JSON.pretty_generate(tool.input_schema) %></code></pre>
            </details>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-2 gap-4 mb-6">
      <div class="outline outline-1 outline-n-container rounded-lg p-4">
        <h2 class="text-lg font-medium text-n-slate-12 mb-2">Agent prompt</h2>
        <pre class="max-h-80 overflow-auto whitespace-pre-wrap rounded bg-slate-100 p-4 text-xs"><code><%= @preview.ai_agent.prompt.presence || 'No agent prompt configured.' %></code></pre>
      </div>
      <div class="outline outline-1 outline-n-container rounded-lg p-4">
        <h2 class="text-lg font-medium text-n-slate-12 mb-2">Tool policy prompt</h2>
        <pre class="max-h-80 overflow-auto whitespace-pre-wrap rounded bg-slate-100 p-4 text-xs"><code><%= @preview.tool_policy_prompt.presence || 'No extra tool policy prompt for the enabled tools.' %></code></pre>
      </div>
    </div>

    <div class="outline outline-1 outline-n-container rounded-lg p-4 mb-6">
      <h2 class="text-lg font-medium text-n-slate-12 mb-2">Base system prompt</h2>
      <pre class="max-h-96 overflow-auto whitespace-pre-wrap rounded bg-slate-100 p-4 text-xs"><code><%= @preview.base_prompt %></code></pre>
    </div>

    <div class="outline outline-1 outline-n-container rounded-lg p-4">
      <h2 class="text-lg font-medium text-n-slate-12 mb-2">Effective system prompt</h2>
      <p class="text-sm text-n-slate-11 mb-3">This is the system prompt assembled for the LLM adapter before conversation messages are added.</p>
      <pre class="max-h-[32rem] overflow-auto whitespace-pre-wrap rounded bg-slate-100 p-4 text-xs"><code><%= @preview.effective_system_prompt %></code></pre>
    </div>
  <% end %>
</section>
