<% content_for(:title) do %>
  Settings
<% end %>
<header class="main-content__header" role="banner">
  <div class="flex items-center gap-3">
    <div class="border border-slate-200 p-1.5 rounded-md text-slate-500">
      <svg width="18" height="18"><use xlink:href="#icon-settings-2-line" /></svg>
    </div>
    <div>
      <h1 class="main-content__page-title" id="page-title">
        <%= content_for(:title) %>
      </h1>
      <p class="text-xs text-slate-600 m-0 -mt-0.5">Update your instance settings, access billing portal</p>
    </div>
  </div>
</header>
<section class="main-content__body">
  <% if Redis::Alfred.get(Redis::Alfred::CHATWOOT_INSTALLATION_CONFIG_RESET_WARNING) %>
    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg relative mb-5 text-sm" role="alert">
      <strong class="font-semibold">Alert:</strong>
      Unauthorized premium changes detected. To keep using them, please upgrade your plan.
      <a href="mailto:sales@kozmopath.com" class="underline ml-1">sales@kozmopath.com</a>
    </div>
  <% end %>

  <div class="bg-white border border-slate-200 rounded-lg shadow-sm p-5">
    <%= javascript_include_tag "secretField" %>
    <div class="flex items-center mb-6">
      <h4 class="text-sm font-medium text-slate-700 mr-4">Installation Identifier</h4>
      <div data-secret-text="<%= ChatwootHub.installation_identifier %>" class="cell-data__secret-field text-sm leading-5 h-5 text-slate-500">
        <span data-secret-masked="true" class="select-none"></span>
        <button type="button" onclick="toggleSecretField(event)" data-secret-toggler class="reset-base inline-flex items-center justify-center h-5 w-5 p-0 rounded text-slate-400 hover:text-slate-600 transition-colors focus:outline-none">
          <svg width="20" height="20" class="w-5 h-5 fill-current">
            <use xlink:href="#eye-show" />
          </svg>
        </button>
        <button type="button" onclick="copySecretField(event)" data-secret-copier class="reset-base inline-flex items-center justify-center h-5 w-5 p-0 rounded text-slate-400 hover:text-slate-600 transition-colors focus:outline-none">
          <svg width="20" height="20" class="w-5 h-5 fill-current">
            <use xlink:href="#icon-copy" />
          </svg>
        </button>
      </div>
    </div>
    <% if ChatwootApp.enterprise? %>
      <div class="flex p-4 border border-slate-200 rounded-lg items-start md:items-center shadow-sm flex-col md:flex-row">
        <div class="flex flex-col flex-grow gap-1">
          <div class="flex items-center gap-2">
            <h2 class="h-5 leading-5 text-slate-900 text-sm font-semibold">Current plan</h2>
            <a href="<%= refresh_super_admin_settings_url %>" class="inline-flex gap-1 text-xs font-medium items-center text-woot-500 hover:text-woot-700">
              <svg width="16" height="16"><use xlink:href="#icon-refresh-line" /></svg>
              <span>Refresh</span>
            </a>
          </div>
          <p class="text-slate-500 m-0 text-sm"><%= SuperAdmin::FeaturesHelper.plan_details %></p>
        </div>
        <a href="<%= ChatwootHub.billing_url %>" target="_blank" rel="noopener noreferrer">
          <button class="reset-base mt-4 md:mt-0 flex gap-1 items-center bg-transparent shadow-sm h-9 hover:text-slate-900 hover:bg-slate-50 border border-slate-200 rounded-lg text-slate-600 font-medium p-2 focus:outline-none transition-colors">
            <svg width="16" height="16"><use xlink:href="#icon-settings-2-line" /></svg>
            <span class="px-1">Manage</span>
          </button>
        </a>
      </div>
    <% end %>

    <% if ChatwootHub.pricing_plan != 'community' &&  User.count > ChatwootHub.pricing_plan_quantity %>
    <div role="alert">
      <div class="border border-t-0 border-red-200 rounded-b-lg bg-red-50 px-4 py-3 text-red-700 text-sm">
        <p class="m-0">You have <%= User.count %> agents. Please add more licenses to add more users.</p>
      </div>
    </div>
    <% end %>


    <div class="flex p-4 border border-slate-200 rounded-lg mt-4 items-start md:items-center shadow-sm flex-col md:flex-row">
      <div class="flex flex-col flex-grow gap-1">
        <h2 class="h-5 leading-5 text-slate-900 text-sm font-semibold">Need help?</h2>
        <p class="text-slate-500 m-0 text-sm">Do you face any issues? We are here to help.</p>
      </div>
      <a href="https://discord.gg/cJXdrwS" target="_blank">
        <button class="reset-base flex mt-4 md:mt-0 gap-1 items-center bg-violet-500 hover:bg-violet-600 text-white h-9 rounded-lg font-medium p-2 focus:outline-none transition-colors">
          <svg class="h-4 w-4" width="24" height="24" fill="none" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M13.209 3.103c-.495-1.004-1.926-1.004-2.421 0L8.43 7.88l-5.273.766c-1.107.161-1.55 1.522-.748 2.303l3.815 3.72-.9 5.25c-.19 1.103.968 1.944 1.959 1.424l4.715-2.48 4.716 2.48c.99.52 2.148-.32 1.96-1.424l-.902-5.25 3.816-3.72c.8-.78.359-2.142-.748-2.303l-5.273-.766-2.358-4.777ZM9.74 8.615l2.258-4.576 2.259 4.576a1.35 1.35 0 0 0 1.016.738l5.05.734-3.654 3.562a1.35 1.35 0 0 0-.388 1.195l.862 5.03-4.516-2.375a1.35 1.35 0 0 0-1.257 0l-4.516 2.374.862-5.029a1.35 1.35 0 0 0-.388-1.195l-3.654-3.562 5.05-.734c.44-.063.82-.34 1.016-.738ZM1.164 3.782a.75.75 0 0 0 .118 1.054l2.5 2a.75.75 0 1 0 .937-1.172l-2.5-2a.75.75 0 0 0-1.055.118Z" fill="currentColor"/><path d="M22.836 18.218a.75.75 0 0 0-.117-1.054l-2.5-2a.75.75 0 0 0-.938 1.172l2.5 2a.75.75 0 0 0 1.055-.117ZM1.282 17.164a.75.75 0 1 0 .937 1.172l2.5-2a.75.75 0 0 0-.937-1.172l-2.5 2ZM22.836 3.782a.75.75 0 0 1-.117 1.054l-2.5 2a.75.75 0 0 1-.938-1.172l2.5-2a.75.75 0 0 1 1.055.118Z"  fill="currentColor"/></svg>
          <span class="px-1">Community Support</span>
        </button>
      </a>
      <% if ChatwootHub.pricing_plan !='community' %>
        <button class="reset-base ml-3 flex gap-1 items-center bg-transparent h-9 hover:text-slate-900 hover:bg-slate-50 border border-slate-200 rounded-lg text-slate-600 font-medium p-2 focus:outline-none transition-colors" onclick="window.$kozmopath.toggle('open')">
          <svg class="h-4 w-4" width="24" height="24" fill="none" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M13.209 3.103c-.495-1.004-1.926-1.004-2.421 0L8.43 7.88l-5.273.766c-1.107.161-1.55 1.522-.748 2.303l3.815 3.72-.9 5.25c-.19 1.103.968 1.944 1.959 1.424l4.715-2.48 4.716 2.48c.99.52 2.148-.32 1.96-1.424l-.902-5.25 3.816-3.72c.8-.78.359-2.142-.748-2.303l-5.273-.766-2.358-4.777ZM9.74 8.615l2.258-4.576 2.259 4.576a1.35 1.35 0 0 0 1.016.738l5.05.734-3.654 3.562a1.35 1.35 0 0 0-.388 1.195l.862 5.03-4.516-2.375a1.35 1.35 0 0 0-1.257 0l-4.516 2.374.862-5.029a1.35 1.35 0 0 0-.388-1.195l-3.654-3.562 5.05-.734c.44-.063.82-.34 1.016-.738ZM1.164 3.782a.75.75 0 0 0 .118 1.054l2.5 2a.75.75 0 1 0 .937-1.172l-2.5-2a.75.75 0 0 0-1.055.118Z" fill="currentColor"/><path d="M22.836 18.218a.75.75 0 0 0-.117-1.054l-2.5-2a.75.75 0 0 0-.938 1.172l2.5 2a.75.75 0 0 0 1.055-.117ZM1.282 17.164a.75.75 0 1 0 .937 1.172l2.5-2a.75.75 0 0 0-.937-1.172l-2.5 2ZM22.836 3.782a.75.75 0 0 1-.117 1.054l-2.5 2a.75.75 0 0 1-.938-1.172l2.5-2a.75.75 0 0 1 1.055.118Z"  fill="currentColor"/></svg>
          <span class="px-1">Chat Support</span>
        </button>
      <% end %>
    </div>
    <div class="mt-8 py-3">
      <h3 class="text-base font-semibold text-slate-900">Features</h3>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
      <a class="group border border-slate-200 p-4 rounded-lg relative shadow-sm no-underline hover:border-slate-300 hover:shadow transition-all" href="<%= super_admin_ai_agent_tools_path %>">
        <div class="flex items-center justify-center w-9 h-9 mb-3 border border-slate-200 text-slate-600 rounded-lg">
          <svg width="18" height="18"><use xlink:href="#icon-bot" /></svg>
        </div>
        <div class="flex items-center justify-between mb-1 mt-3">
          <h3 class="text-slate-900 font-semibold text-sm">AI Agent Tools</h3>
        </div>
        <p class="text-slate-500 mb-0 text-sm">Review AI agent tool registry metadata and execution analytics.</p>
      </a>
      <a class="group border border-slate-200 p-4 rounded-lg relative shadow-sm no-underline hover:border-slate-300 hover:shadow transition-all" href="<%= super_admin_ai_agent_prompt_preview_path %>">
        <div class="flex items-center justify-center w-9 h-9 mb-3 border border-slate-200 text-slate-600 rounded-lg">
          <svg width="18" height="18"><use xlink:href="#icon-bot" /></svg>
        </div>
        <div class="flex items-center justify-between mb-1 mt-3">
          <h3 class="text-slate-900 font-semibold text-sm">AI Prompt Preview</h3>
        </div>
        <p class="text-slate-500 mb-0 text-sm">Inspect effective AI agent prompts, enabled tools, and integration gates.</p>
      </a>
      <a class="group border border-slate-200 p-4 rounded-lg relative shadow-sm no-underline hover:border-slate-300 hover:shadow transition-all" href="<%= super_admin_ai_agent_llm_calls_path %>">
        <div class="flex items-center justify-center w-9 h-9 mb-3 border border-slate-200 text-slate-600 rounded-lg">
          <svg width="18" height="18"><use xlink:href="#icon-bot" /></svg>
        </div>
        <div class="flex items-center justify-between mb-1 mt-3">
          <h3 class="text-slate-900 font-semibold text-sm">AI LLM Calls</h3>
        </div>
        <p class="text-slate-500 mb-0 text-sm">Review exact AI request messages, tool schemas, responses, and usage.</p>
      </a>
      <a class="group border border-slate-200 p-4 rounded-lg relative shadow-sm no-underline hover:border-slate-300 hover:shadow transition-all" href="<%= super_admin_voice_ai_calls_path %>">
        <div class="flex items-center justify-center w-9 h-9 mb-3 border border-slate-200 text-slate-600 rounded-lg">
          <svg width="18" height="18"><use xlink:href="#icon-bot" /></svg>
        </div>
        <div class="flex items-center justify-between mb-1 mt-3">
          <h3 class="text-slate-900 font-semibold text-sm">Voice AI Calls</h3>
        </div>
        <p class="text-slate-500 mb-0 text-sm">Inspect voice calls, recordings, transcripts, and raw voice tool events.</p>
      </a>
      <a class="group border border-slate-200 p-4 rounded-lg relative shadow-sm no-underline hover:border-slate-300 hover:shadow transition-all" href="<%= super_admin_voice_numbers_path %>">
        <div class="flex items-center justify-center w-9 h-9 mb-3 border border-slate-200 text-slate-600 rounded-lg">
          <svg width="18" height="18"><use xlink:href="#icon-message-line" /></svg>
        </div>
        <div class="flex items-center justify-between mb-1 mt-3">
          <h3 class="text-slate-900 font-semibold text-sm">Voice Telephony</h3>
        </div>
        <p class="text-slate-500 mb-0 text-sm">Configure SIP provider connections and phone numbers for Voice AI.</p>
      </a>
      <% SuperAdmin::FeaturesHelper.available_features.each do |feature, attrs| %>
        <% next if attrs[:hidden] %>
        <div class="group border border-slate-200 p-4 rounded-lg relative shadow-sm hover:border-slate-300 hover:shadow transition-all">
          <span class="<%= attrs[:enabled] ? 'bg-green-500 text-white': 'bg-slate-300 text-slate-700' %> absolute rounded-full p-1 inline-flex right-3 top-3">
            <svg width="12" height="12"><use xlink:href="<%= attrs[:enabled] ? '#icon-tick-line': '#icon-lock-line' %>" /></svg>
          </span>
          <div class="visible <% if !attrs[:enabled] %> group-hover:invisible <% end %> flex items-center justify-center w-9 h-9 mb-3 border border-slate-200 text-slate-600 rounded-lg">
            <svg width="18" height="18"><use xlink:href="#<%= attrs[:icon] %>" /></svg>
          </div>
          <% if !attrs[:enabled] %>
          <div class="flex h-9 absolute top-3 items-center invisible group-hover:visible">
            <% if ChatwootApp.enterprise? %>
              <%= render 'upgrade_button_enterprise' %>
            <% else %>
              <%= render 'upgrade_button_community' %>
            <% end %>
          </div>
          <% end %>
          <div class="flex items-center justify-between mb-1 mt-3">
            <div class="flex items-center gap-2">
              <h3 class="text-slate-900 font-semibold text-sm"><%= attrs[:name] %></h3>
              <% if attrs[:enterprise] %>
                <span class="px-1.5 h-4 leading-4 rounded-md text-green-700 font-semibold bg-green-50 text-xxs">EE</span>
              <% end %>
              <% if attrs[:config_key].present? && attrs[:enabled] %>
                <a class="inline-flex items-center justify-center h-5 w-5 hover:bg-slate-100 rounded transition-colors" href="/super_admin/app_config?config=<%= attrs[:config_key] %>">
                  <svg width="16" height="16"><use xlink:href="#icon-gear" /></svg>
                </a>
              <% end %>
            </div>
          </div>
          <p class="text-slate-500 mb-0 text-sm"><%= attrs[:description] %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>
