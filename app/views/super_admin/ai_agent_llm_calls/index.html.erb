<% content_for(:title) do %>
  AI LLM Calls
<% end %>

<header class="main-content__header" role="banner">
  <div class="flex items-center gap-3">
    <div class="border border-slate-200 p-1.5 rounded-md text-slate-500">
      <svg width="18" height="18"><use xlink:href="#icon-bot" /></svg>
    </div>
    <div>
      <h1 class="main-content__page-title" id="page-title">
        <%= content_for(:title) %>
      </h1>
      <p class="text-xs text-slate-600 m-0 -mt-0.5">Inspect exact messages sent to the AI provider.</p>
    </div>
  </div>
</header>

<section class="main-content__body">
  <div class="bg-white border border-slate-200 rounded-lg shadow-sm p-5">
    <div class="flex flex-col gap-2 mb-5">
      <div class="flex items-center justify-between gap-3 flex-wrap">
        <div>
          <h2 class="text-base font-semibold text-slate-900 m-0">Recent LLM calls</h2>
          <p class="text-sm text-slate-500 m-0">Showing the latest 50 matching calls.</p>
        </div>
        <%= link_to 'Tool executions', super_admin_ai_agent_tool_executions_path, class: 'button button--secondary' %>
      </div>
      <%= form_with url: super_admin_ai_agent_llm_calls_path, method: :get, local: true, class: 'flex flex-wrap gap-3 mt-3' do %>
        <select name="account_id" class="rounded border border-slate-300 p-2 text-sm">
          <option value="">All accounts</option>
          <% @account_options.each do |id, name| %>
            <option value="<%= id %>" <%= 'selected' if params[:account_id].to_i == id %>><%= name %></option>
          <% end %>
        </select>
        <select name="status" class="rounded border border-slate-300 p-2 text-sm">
          <option value="">All statuses</option>
          <% AiAgentLlmCall.statuses.keys.each do |status| %>
            <option value="<%= status %>" <%= 'selected' if params[:status] == status %>><%= status.humanize %></option>
          <% end %>
        </select>
        <select name="step" class="rounded border border-slate-300 p-2 text-sm">
          <option value="">All steps</option>
          <% @step_options.each do |step| %>
            <option value="<%= step %>" <%= 'selected' if params[:step] == step %>><%= step.humanize %></option>
          <% end %>
        </select>
        <input
          name="conversation_display_id"
          value="<%= params[:conversation_display_id] %>"
          placeholder="Conversation display ID"
          class="rounded border border-slate-300 p-2 text-sm"
        />
        <button type="submit" class="button button--primary">Apply</button>
        <%= link_to 'Clear', super_admin_ai_agent_llm_calls_path, class: 'button button--secondary' %>
      <% end %>
    </div>

    <% if @llm_calls.empty? %>
      <p class="text-sm text-slate-500 m-0">No LLM calls found.</p>
    <% else %>
      <div class="overflow-x-auto rounded-lg border border-slate-200">
        <table class="w-full text-left">
          <thead class="bg-slate-50 border-b border-slate-200">
            <tr>
              <th class="px-4 py-3 text-sm font-medium text-slate-900">Time</th>
              <th class="px-4 py-3 text-sm font-medium text-slate-900">Account</th>
              <th class="px-4 py-3 text-sm font-medium text-slate-900">Step</th>
              <th class="px-4 py-3 text-sm font-medium text-slate-900">Status</th>
              <th class="px-4 py-3 text-sm font-medium text-slate-900">Conversation</th>
              <th class="px-4 py-3 text-sm font-medium text-slate-900">Messages</th>
              <th class="px-4 py-3 text-sm font-medium text-slate-900">Details</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            <% @llm_calls.each do |llm_call| %>
              <tr class="align-top hover:bg-slate-50">
                <td class="px-4 py-3 text-sm text-slate-600 whitespace-nowrap"><%= time_ago_in_words(llm_call.created_at) %> ago</td>
                <td class="px-4 py-3 text-sm text-slate-900"><%= llm_call.account&.name || "Account ##{llm_call.account_id}" %></td>
                <td class="px-4 py-3 text-sm text-slate-700"><%= llm_call.step.humanize %></td>
                <td class="px-4 py-3 text-sm">
                  <% status_class = llm_call.succeeded? ? 'bg-green-50 text-green-700' : 'bg-red-50 text-red-700' %>
                  <span class="inline-flex rounded-full px-2 py-1 text-xs font-medium <%= status_class %>"><%= llm_call.status.humanize %></span>
                </td>
                <td class="px-4 py-3 text-sm text-slate-700">
                  <% if llm_call.conversation %>
                    <% conversation_path = "/app/accounts/#{llm_call.account_id}/conversations/#{llm_call.conversation.display_id}" %>
                    <%= link_to "##{llm_call.conversation.display_id}", conversation_path, class: 'text-woot-600 hover:underline' %>
                  <% else %>
                    -
                  <% end %>
                </td>
                <td class="px-4 py-3 text-sm text-slate-700"><%= llm_call.request_messages.length %></td>
                <td class="px-4 py-3 text-sm text-slate-700 min-w-[32rem]">
                  <details>
                    <summary class="cursor-pointer text-woot-600 hover:underline">Request messages</summary>
                    <pre class="mt-2 max-h-96 overflow-auto whitespace-pre-wrap rounded bg-slate-50 border border-slate-200 p-3 text-xs">
<code><%= JSON.pretty_generate(llm_call.request_messages) %></code></pre>
                  </details>
                  <details class="mt-2">
                    <summary class="cursor-pointer text-woot-600 hover:underline">Response</summary>
                    <pre class="mt-2 max-h-96 overflow-auto whitespace-pre-wrap rounded bg-slate-50 border border-slate-200 p-3 text-xs">
<code><%= JSON.pretty_generate(llm_call.response) %></code></pre>
                  </details>
                  <div class="mt-2 text-xs text-slate-500">
                    Tools: <%= llm_call.request_tool_names.presence&.join(', ') || '-' %>
                    · Model: <%= llm_call.model.presence || '-' %>
                    · Duration: <%= llm_call.duration_ms || '-' %>ms
                  </div>
                  <% if llm_call.error_message.present? %>
                    <p class="mt-2 mb-0 text-xs text-red-700"><%= llm_call.error_code %>: <%= llm_call.error_message %></p>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</section>
