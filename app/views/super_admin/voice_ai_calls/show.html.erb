<% content_for(:title) do %>
  Voice AI Call #<%= @call.id %>
<% end %>

<header class="main-content__header" role="banner">
  <div class="flex items-center gap-3">
    <div class="border border-slate-200 p-1.5 rounded-md text-slate-500">
      <svg width="18" height="18"><use xlink:href="#icon-bot" /></svg>
    </div>
    <div>
      <h1 class="main-content__page-title" id="page-title">
        <%= content_for(:title) %>
      </h1>
      <p class="text-xs text-slate-600 m-0 -mt-0.5">Raw Super Admin diagnostics for this LiveKit call.</p>
    </div>
  </div>
  <div class="flex flex-wrap gap-2">
    <%= link_to 'Download redacted JSON',
                diagnostics_super_admin_voice_ai_call_path(@call, format: :json),
                class: 'button button--secondary' %>
    <%= link_to 'View raw JSON',
                diagnostics_super_admin_voice_ai_call_path(@call, format: :json, raw: true),
                class: 'button button--secondary' %>
    <%= link_to 'Back to Voice AI Calls', super_admin_voice_ai_calls_path, class: 'button button--secondary' %>
  </div>
</header>

<section class="main-content__body">
  <div class="grid grid-cols-1 gap-5">
    <div class="bg-white border border-slate-200 rounded-lg shadow-sm p-5">
      <h2 class="text-base font-semibold text-slate-900 m-0 mb-4">AI diagnostic summary</h2>
      <p class="text-sm text-slate-700 mt-0 mb-4"><%= @diagnostics[:summary] %></p>
      <% if @diagnostics[:failure_reasons].present? %>
        <div class="flex flex-wrap gap-2 mb-4">
          <% @diagnostics[:failure_reasons].each do |reason| %>
            <span class="inline-flex rounded-full bg-red-50 px-2.5 py-1 text-xs font-medium text-red-700"><%= reason.humanize %></span>
          <% end %>
        </div>
      <% else %>
        <span class="inline-flex rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-700">No detected failure reason</span>
      <% end %>
      <div class="mt-4">
        <h3 class="text-xs font-semibold uppercase text-slate-500">Next checks</h3>
        <ul class="text-sm text-slate-700 mb-0">
          <% @diagnostics[:next_checks].each do |check| %>
            <li><%= check %></li>
          <% end %>
        </ul>
      </div>
    </div>

    <div class="bg-white border border-slate-200 rounded-lg shadow-sm p-5">
      <h2 class="text-base font-semibold text-slate-900 m-0 mb-4">Call metadata</h2>
      <dl class="super-admin-field-summary">
        <div><dt>Account</dt><dd><%= @call.account&.name || "Account ##{@call.account_id}" %></dd></div>
        <div><dt>Inbox</dt><dd><%= @call.inbox&.name || "Inbox ##{@call.inbox_id}" %></dd></div>
        <div><dt>Status</dt><dd><%= @call.status.humanize %></dd></div>
        <div><dt>Kind</dt><dd><%= @call.test_call? ? 'Test' : 'Live' %></dd></div>
        <div><dt>Provider call ID</dt><dd><%= @call.provider_call_id %></dd></div>
        <div><dt>LiveKit room</dt><dd><%= @call.livekit_room_name.presence || '-' %></dd></div>
        <div><dt>Voice agent ID</dt><dd><%= @call.meta&.fetch('voice_agent_id', '-') %></dd></div>
        <div><dt>Handoff</dt><dd><%= @call.handoff_status.presence || '-' %></dd></div>
        <div><dt>AI status</dt><dd><%= @call.ai_status.presence || '-' %></dd></div>
        <div><dt>Duration</dt><dd><%= @call.duration_seconds || '-' %>s</dd></div>
        <div><dt>Started</dt><dd><%= @call.started_at ? l(@call.started_at, format: :long) : '-' %></dd></div>
        <div><dt>Ended reason</dt><dd><%= @call.end_reason.presence || '-' %></dd></div>
      </dl>
      <% if @call.conversation %>
        <p class="mt-4 mb-0 text-sm">
          Conversation:
          <%= link_to(
            "##{@call.conversation.display_id}",
            "/app/accounts/#{@call.account_id}/conversations/#{@call.conversation.display_id}",
            class: 'text-woot-600 hover:underline'
          ) %>
        </p>
      <% end %>
    </div>

    <div class="bg-white border border-slate-200 rounded-lg shadow-sm p-5">
      <h2 class="text-base font-semibold text-slate-900 m-0 mb-4">Raw voice tool events</h2>
      <% if @tool_events.empty? %>
        <p class="text-sm text-slate-500 m-0">No tool events recorded.</p>
      <% else %>
        <div class="flex flex-col gap-3">
          <% @tool_events.each do |event| %>
            <% event_arguments_json = JSON.pretty_generate(event.arguments || {}) %>
            <% event_result_json = JSON.pretty_generate(event.result || {}) %>
            <details class="rounded-lg border border-slate-200 bg-slate-50 p-3">
              <summary class="cursor-pointer text-sm font-medium text-slate-900">
                <%= event.tool %> · <%= event.status %> · <%= time_ago_in_words(event.created_at) %> ago
              </summary>
              <% if event.error_message.present? %>
                <p class="mt-3 mb-0 text-sm text-red-700"><%= event.error_message %></p>
              <% end %>
              <div class="grid grid-cols-1 gap-3 lg:grid-cols-2 mt-3">
                <div>
                  <h3 class="text-xs font-semibold uppercase text-slate-500">Arguments</h3>
                  <pre
                    class="max-h-96 overflow-auto whitespace-pre-wrap rounded bg-white border border-slate-200 p-3 text-xs"
                  ><code><%= event_arguments_json %></code></pre>
                </div>
                <div>
                  <h3 class="text-xs font-semibold uppercase text-slate-500">Result</h3>
                  <pre
                    class="max-h-96 overflow-auto whitespace-pre-wrap rounded bg-white border border-slate-200 p-3 text-xs"
                  ><code><%= event_result_json %></code></pre>
                </div>
              </div>
              <p class="mt-2 mb-0 text-xs text-slate-500">
                Source: <%= event.source %> · Duration: <%= event.duration_ms || '-' %>ms · External ID: <%= event.external_id.presence || '-' %>
              </p>
            </details>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="bg-white border border-slate-200 rounded-lg shadow-sm p-5">
      <h2 class="text-base font-semibold text-slate-900 m-0 mb-4">Transcript</h2>
      <% if @transcript_segments.empty? %>
        <p class="text-sm text-slate-500 m-0">No transcript segments recorded.</p>
      <% else %>
        <div class="flex flex-col gap-2">
          <% @transcript_segments.each do |segment| %>
            <div class="rounded-lg border border-slate-200 p-3">
              <div class="mb-1 flex items-center justify-between gap-3 text-xs text-slate-500">
                <span><%= segment.role %> · <%= segment.source %></span>
                <span><%= l(segment.created_at, format: :long) %></span>
              </div>
              <p class="m-0 whitespace-pre-wrap text-sm text-slate-900"><%= segment.text %></p>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="bg-white border border-slate-200 rounded-lg shadow-sm p-5">
      <h2 class="text-base font-semibold text-slate-900 m-0 mb-4">Recordings</h2>
      <% if @recordings.empty? %>
        <p class="text-sm text-slate-500 m-0">No recording rows found.</p>
      <% else %>
        <div class="overflow-x-auto rounded-lg border border-slate-200">
          <table class="w-full text-left">
            <thead class="bg-slate-50 border-b border-slate-200">
              <tr>
                <th class="px-4 py-3 text-sm font-medium text-slate-900">Status</th>
                <th class="px-4 py-3 text-sm font-medium text-slate-900">Provider</th>
                <th class="px-4 py-3 text-sm font-medium text-slate-900">Object</th>
                <th class="px-4 py-3 text-sm font-medium text-slate-900">Duration</th>
                <th class="px-4 py-3 text-sm font-medium text-slate-900">Error</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200">
              <% @recordings.each do |recording| %>
                <tr>
                  <td class="px-4 py-3 text-sm text-slate-700"><%= recording.status %></td>
                  <td class="px-4 py-3 text-sm text-slate-700"><%= recording.storage_provider %></td>
                  <td class="px-4 py-3 text-sm text-slate-700 max-w-xl break-all"><%= recording.object_key.presence || '-' %></td>
                  <td class="px-4 py-3 text-sm text-slate-700"><%= recording.duration_seconds || '-' %>s</td>
                  <td class="px-4 py-3 text-sm text-red-700"><%= recording.error_message.presence || '-' %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  </div>
</section>
