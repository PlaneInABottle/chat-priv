<% content_for(:title) do %>
  Voice AI Calls
<% end %>

<header class="main-content__header" role="banner">
  <div class="flex items-center gap-3">
    <div class="border border-slate-200 p-1.5 rounded-md text-slate-500">
      <svg width="18" height="18"><use xlink:href="#icon-bot" /></svg>
    </div>
    <div>
      <h1 class="main-content__page-title" id="page-title">
        <%= content_for(:title) %>
      </h1>
      <p class="text-xs text-slate-600 m-0 -mt-0.5">Inspect voice calls, transcripts, recordings, and raw voice tool events.</p>
    </div>
  </div>
</header>

<section class="main-content__body">
  <div class="bg-white border border-slate-200 rounded-lg shadow-sm p-5">
    <div class="flex flex-col gap-2 mb-5">
      <div>
        <h2 class="text-base font-semibold text-slate-900 m-0">Recent Voice AI calls</h2>
        <p class="text-sm text-slate-500 m-0">Showing the latest <%= SuperAdmin::VoiceAiCallsController::LIMIT %> matching calls.</p>
      </div>
      <%= form_with url: super_admin_voice_ai_calls_path, method: :get, local: true, class: 'flex flex-wrap gap-3 mt-3' do %>
        <select name="account_id" class="rounded border border-slate-300 p-2 text-sm">
          <option value="">All accounts</option>
          <% @account_options.each do |id, name| %>
            <option value="<%= id %>" <%= 'selected' if params[:account_id].to_i == id %>><%= name %></option>
          <% end %>
        </select>
        <select name="status" class="rounded border border-slate-300 p-2 text-sm">
          <option value="">All statuses</option>
          <% Call::STATUSES.each do |status| %>
            <option value="<%= status %>" <%= 'selected' if params[:status] == status %>><%= status.humanize %></option>
          <% end %>
        </select>
        <select name="test_call" class="rounded border border-slate-300 p-2 text-sm">
          <option value="">Test and live calls</option>
          <option value="true" <%= 'selected' if params[:test_call] == 'true' %>>Test calls only</option>
          <option value="false" <%= 'selected' if params[:test_call] == 'false' %>>Live calls only</option>
        </select>
        <input
          name="room"
          value="<%= params[:room] %>"
          placeholder="Room or call reference"
          class="min-w-64 rounded border border-slate-300 p-2 text-sm"
        />
        <button type="submit" class="button button--primary">Apply</button>
        <%= link_to 'Clear', super_admin_voice_ai_calls_path, class: 'button button--secondary' %>
      <% end %>
    </div>

    <% if @calls.empty? %>
      <p class="text-sm text-slate-500 m-0">No Voice AI calls found.</p>
    <% else %>
      <div class="overflow-x-auto rounded-lg border border-slate-200">
        <table class="w-full text-left">
          <thead class="bg-slate-50 border-b border-slate-200">
            <tr>
              <th class="px-4 py-3 text-sm font-medium text-slate-900">Time</th>
              <th class="px-4 py-3 text-sm font-medium text-slate-900">Account</th>
              <th class="px-4 py-3 text-sm font-medium text-slate-900">Inbox</th>
              <th class="px-4 py-3 text-sm font-medium text-slate-900">Status</th>
              <th class="px-4 py-3 text-sm font-medium text-slate-900">Kind</th>
              <th class="px-4 py-3 text-sm font-medium text-slate-900">Voice room</th>
              <th class="px-4 py-3 text-sm font-medium text-slate-900">Signals</th>
              <th class="px-4 py-3 text-sm font-medium text-slate-900">Details</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            <% @calls.each do |call| %>
              <% latest_recording = call.voice_recordings.max_by(&:created_at) %>
              <tr class="align-top hover:bg-slate-50">
                <td class="px-4 py-3 text-sm text-slate-600 whitespace-nowrap"><%= time_ago_in_words(call.created_at) %> ago</td>
                <td class="px-4 py-3 text-sm text-slate-900"><%= call.account&.name || "Account ##{call.account_id}" %></td>
                <td class="px-4 py-3 text-sm text-slate-700"><%= call.inbox&.name || "Inbox ##{call.inbox_id}" %></td>
                <td class="px-4 py-3 text-sm">
                  <span class="inline-flex rounded-full bg-slate-100 px-2 py-1 text-xs font-medium text-slate-700"><%= call.status.humanize %></span>
                </td>
                <td class="px-4 py-3 text-sm text-slate-700"><%= call.test_call? ? 'Test' : 'Live' %></td>
                <td class="px-4 py-3 text-sm text-slate-700 max-w-xs break-all"><%= call.livekit_room_name.presence || call.provider_call_id %></td>
                <td class="px-4 py-3 text-sm text-slate-700">
                  <div><%= pluralize(call.transcript_segments.length, 'transcript') %></div>
                  <div><%= pluralize(call.voice_tool_events.length, 'tool event') %></div>
                  <div>Recording: <%= latest_recording&.status || 'none' %></div>
                </td>
                <td class="px-4 py-3 text-sm">
                  <%= link_to 'Open', super_admin_voice_ai_call_path(call), class: 'text-woot-600 hover:underline' %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</section>
