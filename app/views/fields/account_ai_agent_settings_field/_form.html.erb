<div class="field-unit__label">
  <%= f.label field.attribute %>
</div>
<div class="field-unit__field">
  <div class="ai-agent-settings-panel">
    <div class="ai-agent-settings-panel__header">
      <span class="ai-agent-settings-panel__title">Account access</span>
      <label class="ai-agent-settings-toggle" for="account_ai_agent_settings_enabled">
        <%= hidden_field_tag "#{field.html_name}[enabled]", 'false', id: nil %>
        <%= check_box_tag "#{field.html_name}[enabled]",
                          'true',
                          field.resource.ai_agent_enabled?,
                          id: 'account_ai_agent_settings_enabled' %>
        <span>Enabled</span>
      </label>
    </div>

    <div class="ai-agent-settings-panel__body">
      <div class="ai-agent-settings-control ai-agent-settings-control--model">
        <%= label_tag 'account_ai_agent_settings_model', 'Model' %>
        <%= select_tag "#{field.html_name}[model]",
                       options_for_select(Account::AI_AGENT_MODELS, field.resource.ai_agent_model),
                       id: 'account_ai_agent_settings_model' %>
      </div>

      <div class="ai-agent-settings-control">
        <%= label_tag 'account_ai_agent_settings_conversation_limit', 'Conversation Limit' %>
        <%= number_field_tag "#{field.html_name}[conversation_limit]",
                             field.resource.ai_agent_conversation_limit,
                             id: 'account_ai_agent_settings_conversation_limit',
                             min: 0 %>
        <span class="ai-agent-settings-control__hint">0 = unlimited</span>
      </div>
    </div>
  </div>
</div>
