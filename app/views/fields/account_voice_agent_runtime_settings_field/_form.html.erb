<%= javascript_include_tag 'voiceAgentRuntimeSettings' %>

<div class="field-unit__label">
  <%= f.label field.attribute, t('super_admin.account_voice_agent_runtime_settings.title') %>
</div>
<div class="field-unit__field">
  <div class="ai-agent-settings-panel voice-agent-runtime-panel">
    <div class="ai-agent-settings-panel__header">
      <span class="ai-agent-settings-panel__title"><%= t('super_admin.account_voice_agent_runtime_settings.panel_title') %></span>
      <span class="ai-agent-settings-control__hint">
        <%= t('super_admin.account_voice_agent_runtime_settings.help') %>
      </span>
    </div>

    <% if field.voice_agents.empty? %>
      <p class="text-sm text-slate-500 mb-0"><%= t('super_admin.account_voice_agent_runtime_settings.no_agents') %></p>
    <% else %>
      <div class="voice-agent-runtime-panel__list">
        <% field.voice_agents.each do |voice_agent| %>
          <% input_id_prefix = "account_voice_agent_runtime_settings_#{voice_agent.id}" %>
          <section class="voice-agent-runtime-card" data-voice-runtime-card>
            <div class="voice-agent-runtime-card__header">
              <div>
                <h4><%= voice_agent.name %></h4>
                <p>
                  <%= t('super_admin.account_voice_agent_runtime_settings.id', id: voice_agent.id) %> ·
                  <%= voice_agent.enabled? ? t('super_admin.account_voice_agent_runtime_settings.enabled') : t('super_admin.account_voice_agent_runtime_settings.disabled') %>
                </p>
              </div>
            </div>

            <div class="ai-agent-settings-panel__body">
              <div class="ai-agent-settings-control">
                <%= label_tag "#{input_id_prefix}_architecture", t('super_admin.account_voice_agent_runtime_settings.architecture') %>
                <%= select_tag "#{field.html_name}[#{voice_agent.id}][architecture]",
                               options_for_select(VoiceAgent::ARCHITECTURES.map { |value| [value.titleize, value] }, voice_agent.architecture),
                               id: "#{input_id_prefix}_architecture" %>
              </div>

              <div class="ai-agent-settings-control">
                <%= label_tag "#{input_id_prefix}_provider", t('super_admin.account_voice_agent_runtime_settings.provider') %>
                <%= select_tag "#{field.html_name}[#{voice_agent.id}][provider]",
                               options_for_select(VoiceAgent::PROVIDERS.map { |value| [value.titleize, value] }, voice_agent.provider),
                               id: "#{input_id_prefix}_provider",
                               data: { voice_runtime_provider: true } %>
              </div>

              <div class="ai-agent-settings-control">
                <%= label_tag "#{input_id_prefix}_model", t('super_admin.account_voice_agent_runtime_settings.model') %>
                <%= text_field_tag "#{field.html_name}[#{voice_agent.id}][model]",
                                   voice_agent.model,
                                   id: "#{input_id_prefix}_model",
                                   list: "#{input_id_prefix}_models",
                                   data: { voice_runtime_model: true },
                                   placeholder: t('super_admin.account_voice_agent_runtime_settings.default_from_worker_env') %>
                <datalist id="<%= input_id_prefix %>_models">
                  <% VoiceAgent::OPENAI_REALTIME_MODELS.each do |model| %>
                    <option value="<%= model %>"></option>
                  <% end %>
                </datalist>
              </div>

              <div class="ai-agent-settings-control">
                <%= label_tag "#{input_id_prefix}_voice", t('super_admin.account_voice_agent_runtime_settings.voice') %>
                <%= text_field_tag "#{field.html_name}[#{voice_agent.id}][voice]",
                                   voice_agent.voice,
                                   id: "#{input_id_prefix}_voice",
                                   list: "#{input_id_prefix}_voices",
                                   data: { voice_runtime_voice: true } %>
                <datalist id="<%= input_id_prefix %>_voices">
                  <% VoiceAgent::OPENAI_REALTIME_VOICES.each do |voice| %>
                    <option value="<%= voice %>"></option>
                  <% end %>
                </datalist>
                <span class="ai-agent-settings-control__hint">
                  <%= t('super_admin.account_voice_agent_runtime_settings.openai_runtime_hint') %>
                </span>
              </div>

              <div class="ai-agent-settings-control">
                <%= label_tag "#{input_id_prefix}_language", t('super_admin.account_voice_agent_runtime_settings.language') %>
                <%= text_field_tag "#{field.html_name}[#{voice_agent.id}][language]",
                                   voice_agent.language,
                                   id: "#{input_id_prefix}_language" %>
              </div>
            </div>
          </section>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
