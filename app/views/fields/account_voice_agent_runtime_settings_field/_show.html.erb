<% if field.voice_agents.empty? %>
  No voice agents configured.
<% else %>
  <div class="voice-agent-runtime-summary">
    <% field.voice_agents.each do |voice_agent| %>
      <section class="voice-agent-runtime-summary__card">
        <header>
          <strong><%= voice_agent.name %></strong>
          <span>ID <%= voice_agent.id %></span>
        </header>
        <dl class="super-admin-field-summary">
          <div>
            <dt>Architecture</dt>
            <dd><%= voice_agent.architecture %></dd>
          </div>
          <div>
            <dt>Provider</dt>
            <dd><%= voice_agent.provider %></dd>
          </div>
          <div>
            <dt>Model</dt>
            <dd><%= voice_agent.model.presence || 'Default from worker env' %></dd>
          </div>
          <div>
            <dt>Voice</dt>
            <dd><%= voice_agent.voice %></dd>
          </div>
          <div>
            <dt>Language</dt>
            <dd><%= voice_agent.language %></dd>
          </div>
        </dl>
      </section>
    <% end %>
  </div>
<% end %>
