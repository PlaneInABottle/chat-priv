# Render-optimized Dockerfile for Performance pipeline (64GB RAM, 16 CPU)
# Optimized for maximum build speed with high parallelization

# pre-build stage
FROM node:23.7.0-alpine AS node
FROM ruby:3.4.4-alpine3.21 AS pre-builder

ARG NODE_VERSION="23.7.0"
ARG PNPM_VERSION="10.2.0"
ENV NODE_VERSION=${NODE_VERSION}
ENV PNPM_VERSION=${PNPM_VERSION}

# ARG default to production settings
ARG BUNDLE_WITHOUT="development:test"
ENV BUNDLE_WITHOUT ${BUNDLE_WITHOUT}
ENV BUNDLER_VERSION=4.0.3

ARG RAILS_SERVE_STATIC_FILES=true
ENV RAILS_SERVE_STATIC_FILES ${RAILS_SERVE_STATIC_FILES}

ARG RAILS_ENV=production
ENV RAILS_ENV ${RAILS_ENV}

# Node memory optimized for Performance pipeline (64GB RAM available)
# Increased from 1536MB to take advantage of available memory
ARG NODE_OPTIONS="--max-old-space-size=8192 --openssl-legacy-provider"
ENV NODE_OPTIONS ${NODE_OPTIONS}

# Aggressive memory settings for fastest builds with 64GB RAM available
ENV RUBY_GC_HEAP_GROWTH_FACTOR=1.5
ENV RUBY_GC_MALLOC_LIMIT=32000000
ENV MALLOC_ARENA_MAX=8
ENV BUNDLE_PATH="/gems"

RUN apk add --no-cache \
  openssl \
  openssl-dev \
  tar \
  build-base \
  tzdata \
  postgresql-dev \
  postgresql-client \
  git \
  curl \
  xz \
  musl-dev \
  linux-headers \
  ruby-full \
  ruby-dev \
  vips \
  && mkdir -p /var/app \
  && gem install bundler -v 4.0.3 --no-document

COPY --from=node /usr/local/bin/node /usr/local/bin/
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
  && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

RUN npm install -g pnpm@${PNPM_VERSION}

ENV PNPM_HOME="/root/.local/share/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

WORKDIR /app

COPY Gemfile Gemfile.lock ./
RUN bundle config set --local force_ruby_platform true \
  && bundle config set --local clean 'true' \
  && gem install bundler -v 4.0.3 --no-document

# Parallel gem installation with max jobs for Performance pipeline (64GB RAM, 16 CPU)
RUN if [ "$RAILS_ENV" = "production" ]; then \
  bundle config set without 'development test'; bundle install -j 8 -r 3; \
  else bundle install -j 8 -r 3; \
  fi

COPY package.json pnpm-lock.yaml ./
# Disable Husky git hooks in Docker builds (no .git directory)
ENV HUSKY=0
RUN pnpm i --frozen-lockfile

COPY . /app

RUN mkdir -p /app/log

# Asset precompile with aggressive settings for Performance pipeline
RUN if [ "$RAILS_ENV" = "production" ]; then \
  DISABLE_SPRING=1 \
  MALLOC_ARENA_MAX=8 \
  RUBY_GC_HEAP_GROWTH_FACTOR=1.5 \
  RUBY_GC_MALLOC_LIMIT=32000000 \
  SECRET_KEY_BASE=precompile_placeholder \
  RAILS_LOG_TO_STDOUT=enabled \
  bundle exec rake assets:precompile \
  && rm -rf spec node_modules tmp/cache .pnpm-store; \
  fi


# Final cleanup
RUN rm -rf /gems/ruby/*/cache/*.gem \
  && find /gems -name "*.c" -delete 2>/dev/null || true \
  && find /gems -name "*.o" -delete 2>/dev/null || true \
  && rm -rf .git .gitignore tmp/cache \
  && mkdir -p /app/tmp/cache /app/tmp/pids /app/tmp/sockets

# final build stage
FROM ruby:3.4.4-alpine3.21

ARG NODE_VERSION="23.7.0"
ARG PNPM_VERSION="10.2.0"
ARG GIT_SHA="unknown"
ENV NODE_VERSION=${NODE_VERSION}
ENV PNPM_VERSION=${PNPM_VERSION}

ARG BUNDLE_WITHOUT="development:test"
ENV BUNDLE_WITHOUT ${BUNDLE_WITHOUT}
ENV BUNDLER_VERSION=4.0.3

ARG EXECJS_RUNTIME="Disabled"
ENV EXECJS_RUNTIME ${EXECJS_RUNTIME}

ARG RAILS_SERVE_STATIC_FILES=true
ENV RAILS_SERVE_STATIC_FILES ${RAILS_SERVE_STATIC_FILES}

ARG BUNDLE_FORCE_RUBY_PLATFORM=1
ENV BUNDLE_FORCE_RUBY_PLATFORM ${BUNDLE_FORCE_RUBY_PLATFORM}

ARG RAILS_ENV=production
ENV RAILS_ENV ${RAILS_ENV}
ENV BUNDLE_PATH="/gems"

RUN apk add --no-cache \
  openssl \
  tzdata \
  postgresql-client \
  imagemagick \
  vips \
  libstdc++ \
  && gem install bundler -v 4.0.3 --no-document

COPY --from=node /usr/local/bin/node /usr/local/bin/
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules

RUN if [ "$RAILS_ENV" != "production" ]; then \
  apk add --no-cache curl git \
  && ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
  && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
  && npm install -g pnpm@${PNPM_VERSION} \
  && pnpm --version; \
  fi

COPY --from=pre-builder /gems/ /gems/
COPY --from=pre-builder /app /app

WORKDIR /app

RUN adduser -D -u 1000 chatwoot \
  && echo "${GIT_SHA}" > /app/.git_sha \
  && chown -R chatwoot:chatwoot /app /gems

USER chatwoot

EXPOSE 3000

CMD ["bundle", "exec", "rails", "server", "-b", "0.0.0.0"]
