# Render-optimized Dockerfile for memory-constrained builds (~4GB)
# Uses sequential builds to minimize peak memory usage

# pre-build stage
FROM node:23.7.0-alpine as node
FROM ruby:3.4.4-alpine3.21 AS pre-builder

ARG NODE_VERSION="23.7.0"
ARG PNPM_VERSION="10.2.0"
ENV NODE_VERSION=${NODE_VERSION}
ENV PNPM_VERSION=${PNPM_VERSION}

# ARG default to production settings
ARG BUNDLE_WITHOUT="development:test"
ENV BUNDLE_WITHOUT ${BUNDLE_WITHOUT}
ENV BUNDLER_VERSION=2.5.11

ARG RAILS_SERVE_STATIC_FILES=true
ENV RAILS_SERVE_STATIC_FILES ${RAILS_SERVE_STATIC_FILES}

ARG RAILS_ENV=production
ENV RAILS_ENV ${RAILS_ENV}

# Reduced Node memory for constrained environments
ARG NODE_OPTIONS="--max-old-space-size=1024 --openssl-legacy-provider"
ENV NODE_OPTIONS ${NODE_OPTIONS}

# Aggressive memory optimization for Ruby/Bundler during build
ENV RUBY_GC_HEAP_GROWTH_FACTOR=1.1
ENV RUBY_GC_MALLOC_LIMIT=8000000
ENV MALLOC_ARENA_MAX=2
ENV BUNDLE_PATH="/gems"

RUN apk update && apk add --no-cache \
  openssl \
  tar \
  build-base \
  tzdata \
  postgresql-dev \
  postgresql-client \
  git \
  curl \
  xz \
  && mkdir -p /var/app \
  && gem install bundler

COPY --from=node /usr/local/bin/node /usr/local/bin/
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
  && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

RUN npm install -g pnpm@${PNPM_VERSION}

ENV PNPM_HOME="/root/.local/share/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

WORKDIR /app

COPY Gemfile Gemfile.lock ./

# natively compile grpc and protobuf to support alpine musl
RUN apk update && apk add --no-cache build-base musl ruby-full ruby-dev gcc make musl-dev openssl openssl-dev g++ linux-headers xz vips
RUN bundle config set --local force_ruby_platform true

# Sequential gem installation to minimize memory (using -j 1)
RUN if [ "$RAILS_ENV" = "production" ]; then \
  bundle config set without 'development test'; bundle install -j 1 -r 3; \
  else bundle install -j 1 -r 3; \
  fi

# Aggressive cleanup after bundle install
RUN rm -rf /gems/ruby/*/cache/*.gem \
  && find /gems -name "*.c" -delete 2>/dev/null || true \
  && find /gems -name "*.o" -delete 2>/dev/null || true \
  && find /gems -name "*.a" -delete 2>/dev/null || true

COPY package.json pnpm-lock.yaml ./
RUN pnpm i --frozen-lockfile

COPY . /app

RUN mkdir -p /app/log

# Asset precompile with memory constraints
RUN if [ "$RAILS_ENV" = "production" ]; then \
  DISABLE_SPRING=1 \
  MALLOC_ARENA_MAX=2 \
  RUBY_GC_HEAP_GROWTH_FACTOR=1.1 \
  RUBY_GC_MALLOC_LIMIT=8000000 \
  SECRET_KEY_BASE=precompile_placeholder \
  RAILS_LOG_TO_STDOUT=enabled \
  bundle exec rake assets:precompile \
  && rm -rf spec node_modules tmp/cache .pnpm-store; \
  fi

# Generate .git_sha file
RUN if [ -d .git ]; then git rev-parse HEAD > /app/.git_sha; else echo "unknown" > /app/.git_sha; fi

# Final cleanup
RUN rm -rf /gems/ruby/*/cache/*.gem \
  && find /gems -name "*.c" -delete 2>/dev/null || true \
  && find /gems -name "*.o" -delete 2>/dev/null || true \
  && rm -rf .git .gitignore tmp/cache \
  && mkdir -p /app/tmp/cache /app/tmp/pids /app/tmp/sockets

# final build stage
FROM ruby:3.4.4-alpine3.21

ARG NODE_VERSION="23.7.0"
ENV NODE_VERSION=${NODE_VERSION}

ARG BUNDLE_WITHOUT="development:test"
ENV BUNDLE_WITHOUT ${BUNDLE_WITHOUT}
ENV BUNDLER_VERSION=2.5.11

ARG EXECJS_RUNTIME="Disabled"
ENV EXECJS_RUNTIME ${EXECJS_RUNTIME}

ARG RAILS_SERVE_STATIC_FILES=true
ENV RAILS_SERVE_STATIC_FILES ${RAILS_SERVE_STATIC_FILES}

ARG BUNDLE_FORCE_RUBY_PLATFORM=1
ENV BUNDLE_FORCE_RUBY_PLATFORM ${BUNDLE_FORCE_RUBY_PLATFORM}

ARG RAILS_ENV=production
ENV RAILS_ENV ${RAILS_ENV}
ENV BUNDLE_PATH="/gems"

RUN apk update && apk add --no-cache \
  openssl \
  tzdata \
  postgresql-client \
  imagemagick \
  vips \
  libstdc++ \
  && gem install bundler

COPY --from=node /usr/local/bin/node /usr/local/bin/
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules

COPY --from=pre-builder /gems/ /gems/
COPY --from=pre-builder /app /app

WORKDIR /app

RUN adduser -D -u 1000 chatwoot
USER chatwoot

EXPOSE 3000

CMD ["bundle", "exec", "rails", "server", "-b", "0.0.0.0"]
